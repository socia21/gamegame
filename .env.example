# Server port (default: 3000)
PORT=3000

# 64-bit access key in 16 hex chars (e.g. DEAD-BEEF-DEAD-BEEF or 0123-4567-89AB-CDEF)
GAME_KEY=DEAD-BEEF-DEAD-BEEF

# World generation seed (default: 42)
MAP_SEED=42

# Max simultaneous player connections (default: 16)
MAX_PLAYERS=16

# Enable debug chat commands (/god, /give, /veh, /tp)
DEBUG_CMDS=0
